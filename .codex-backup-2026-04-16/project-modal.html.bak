<div class="modal-backdrop" (click)="closeModal()">
  <div class="modal-content" (click)="$event.stopPropagation()">
    <button class="close-btn" (click)="closeModal()">×</button>
    <h2>{{ project.title }}</h2>
    <div class="tech-tags">
      @for (tech of project.technologies; track tech) {
        <span class="tag">{{ tech }}</span>
      }
    </div>
    <div class="modal-body">
      @if (project.imageUrl || project.imageUrl2) {
        <div class="modal-media-grid">
          @if (project.imageUrl) {
            <img
              [src]="getImageUrl(project.imageUrl)"
              [alt]="project.title + ' - imagem 1'"
              class="modal-img"
            />
          }
          @if (project.imageUrl2) {
            <img
              [src]="getImageUrl(project.imageUrl2)"
              [alt]="project.title + ' - imagem 2'"
              class="modal-img"
            />
          }
        </div>
      }
      @if (project.video) {
        <video
          #meuVideo
          class="modal-video"
          width="100%"
          autoplay
          loop
          muted
          playsinline
          [attr.poster]="project.imageUrl ? getImageUrl(project.imageUrl) : null"
        >
          <source [src]="project.video" type="video/mp4" />
          Seu navegador não suporta vídeos.
        </video>
      }
      <p class="specs">{{ project.detailedSpecs }}</p>
    </div>
  </div>
</div>
